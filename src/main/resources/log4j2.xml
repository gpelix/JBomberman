<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <Console name="Console">
            <PatternLayout
                    pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="OFF">
            <AppenderRef ref="Console"/>
        </Root>
        <logger name="app.jbomberman.audio" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </logger>
        <logger name="app.jbomberman.model" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </logger>
        <logger name="app.jbomberman.audio.AudioHandle" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </logger>
        <logger name="app.jbomberman.model.AccountBuilder" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </logger>
        <logger name="app.jbomberman.view.graphics.javafx.JavaFXView" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </logger>
        <logger name="app.jbomberman.controller.Controller" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </logger>
    </Loggers>
</Configuration>
